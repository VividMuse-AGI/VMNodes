{
  "schemas": {
    "VMImageEdit": {
      "inputs": {
        "required": {
          "image": [
            "IMAGE"
          ],
          "edit_mask": [
            "MASK"
          ],
          "prompt": [
            "STRING",
            {
              "multiline": true,
              "default": "把上衣改成深红色，保留脸和手。"
            }
          ],
          "selection_mode": [
            [
              "自动选中目标",
              "使用所画遮罩"
            ]
          ],
          "run_mode": [
            [
              "直接生成",
              "仅预览范围"
            ]
          ],
          "model": [
            "MODEL",
            {
              "lazy": true
            }
          ],
          "clip": [
            "CLIP",
            {
              "lazy": true
            }
          ],
          "vae": [
            "VAE",
            {
              "lazy": true
            }
          ],
          "seed": [
            "INT",
            {
              "default": 1001,
              "min": 0,
              "max": 18446744073709551615
            }
          ]
        },
        "optional": {
          "sam_model": [
            "MODEL",
            {
              "lazy": true
            }
          ],
          "sam_clip": [
            "CLIP",
            {
              "lazy": true
            }
          ],
          "protect_mask": [
            "MASK"
          ],
          "reference_image": [
            "IMAGE"
          ],
          "image_context": [
            "VM_IMAGE_CONTEXT"
          ]
        }
      },
      "RETURN_TYPES": [
        "IMAGE",
        "MASK",
        "IMAGE"
      ],
      "RETURN_NAMES": [
        "最终图像",
        "允许区遮罩",
        "范围预览"
      ],
      "FUNCTION": "edit",
      "CATEGORY": "VMNodes/Image",
      "OUTPUT_NODE": null,
      "DEV_ONLY": true
    },
    "VMImageResizeAlign": {
      "inputs": {
        "required": {
          "image": [
            "IMAGE"
          ],
          "resize_mode": [
            [
              "保持原尺寸",
              "按长边",
              "按宽度",
              "按高度"
            ]
          ],
          "target_size": [
            "INT",
            {
              "default": 1024,
              "min": 32,
              "max": 8192
            }
          ],
          "interpolation": [
            [
              "nearest-exact",
              "bilinear",
              "area",
              "bicubic",
              "lanczos"
            ],
            {
              "default": "bicubic"
            }
          ],
          "divisible_by": [
            [
              1,
              8,
              16,
              32,
              64
            ],
            {
              "default": 32
            }
          ]
        },
        "optional": {
          "edit_mask": [
            "MASK"
          ],
          "protect_mask": [
            "MASK"
          ]
        }
      },
      "RETURN_TYPES": [
        "IMAGE",
        "MASK",
        "MASK",
        "VM_IMAGE_CONTEXT",
        "STRING"
      ],
      "RETURN_NAMES": [
        "图像",
        "编辑遮罩",
        "保护遮罩",
        "尺寸上下文",
        "尺寸信息"
      ],
      "FUNCTION": "run",
      "CATEGORY": "VMNodes/Image",
      "OUTPUT_NODE": true,
      "DEV_ONLY": null
    },
    "VMFinalizeEdit": {
      "inputs": {
        "required": {
          "plan": [
            "VM_EDIT_PLAN"
          ],
          "generated_pre": [
            "IMAGE"
          ]
        },
        "optional": {
          "seam_harmonization": [
            [
              "off",
              "auto"
            ],
            {
              "default": "off"
            }
          ]
        }
      },
      "RETURN_TYPES": [
        "IMAGE"
      ],
      "RETURN_NAMES": null,
      "FUNCTION": "finish",
      "CATEGORY": "VMNodes/Internal",
      "OUTPUT_NODE": null,
      "DEV_ONLY": true
    },
    "VMImageEditBridge": {
      "inputs": {
        "required": {
          "image": [
            "IMAGE"
          ],
          "prompt": [
            "STRING",
            {
              "multiline": true,
              "default": "把白色上衣改成深红色，保留脸和手。"
            }
          ],
          "selection_mode": [
            [
              "auto_target",
              "drawn_mask",
              "coarse_region",
              "full_image"
            ],
            {
              "default": "coarse_region"
            }
          ],
          "run_mode": [
            [
              "generate",
              "preview"
            ]
          ],
          "filename_prefix": [
            "STRING",
            {
              "default": "VMNodes/Edit"
            }
          ]
        },
        "optional": {
          "edit_mask": [
            "MASK"
          ],
          "sam_model": [
            "MODEL"
          ],
          "sam_clip": [
            "CLIP"
          ],
          "protect_mask": [
            "MASK"
          ],
          "image_context": [
            "VM_IMAGE_CONTEXT"
          ],
          "generated_pre": [
            "IMAGE"
          ],
          "seam_harmonization": [
            [
              "off",
              "auto"
            ],
            {
              "default": "off"
            }
          ]
        }
      },
      "RETURN_TYPES": [
        "IMAGE",
        "MASK",
        "STRING",
        "IMAGE",
        "MASK",
        "IMAGE",
        "IMAGE",
        "STRING"
      ],
      "RETURN_NAMES": [
        "padded_image",
        "noise_mask",
        "edit_prompt",
        "preview_image",
        "allowed_mask",
        "final_image",
        "guide_image",
        "generation_prompt"
      ],
      "FUNCTION": "needs_frontend",
      "CATEGORY": "VMNodes/Image",
      "OUTPUT_NODE": true,
      "DEV_ONLY": null
    },
    "VMEditPlan": {
      "inputs": {
        "required": {
          "image": [
            "IMAGE"
          ],
          "prompt": [
            "STRING",
            {
              "multiline": true
            }
          ],
          "selection_mode": [
            [
              "auto_target",
              "drawn_mask",
              "coarse_region",
              "full_image"
            ]
          ]
        },
        "optional": {
          "edit_mask": [
            "MASK",
            {
              "lazy": true
            }
          ],
          "sam_model": [
            "MODEL",
            {
              "lazy": true
            }
          ],
          "sam_clip": [
            "CLIP",
            {
              "lazy": true
            }
          ],
          "protect_mask": [
            "MASK"
          ],
          "image_context": [
            "VM_IMAGE_CONTEXT"
          ],
          "canvas_policy": [
            [
              "legacy",
              "external"
            ],
            {
              "default": "legacy"
            }
          ],
          "backend": [
            [
              "qwen21",
              "manual_image"
            ],
            {
              "default": "qwen21"
            }
          ]
        }
      },
      "RETURN_TYPES": [
        "VM_EDIT_PLAN",
        "IMAGE",
        "MASK",
        "STRING",
        "IMAGE",
        "MASK",
        "IMAGE",
        "STRING"
      ],
      "RETURN_NAMES": [
        "plan",
        "padded_image",
        "noise_mask",
        "edit_prompt",
        "preview_image",
        "allowed_mask",
        "guide_image",
        "generation_prompt"
      ],
      "FUNCTION": "build",
      "CATEGORY": "VMNodes/Internal",
      "OUTPUT_NODE": null,
      "DEV_ONLY": true
    },
    "VMEditFinish": {
      "inputs": {
        "required": {
          "plan": [
            "VM_EDIT_PLAN"
          ],
          "run_mode": [
            [
              "generate",
              "preview"
            ]
          ],
          "filename_prefix": [
            "STRING",
            {
              "default": "VMNodes/Edit"
            }
          ]
        },
        "optional": {
          "generated_pre": [
            "IMAGE",
            {
              "lazy": true
            }
          ],
          "frontend_session": [
            "STRING",
            {
              "default": ""
            }
          ],
          "seam_harmonization": [
            [
              "off",
              "auto"
            ],
            {
              "default": "off"
            }
          ]
        },
        "hidden": {
          "prompt": "PROMPT",
          "extra_pnginfo": "EXTRA_PNGINFO",
          "unique_id": "UNIQUE_ID"
        }
      },
      "RETURN_TYPES": [
        "IMAGE",
        "MASK",
        "IMAGE"
      ],
      "RETURN_NAMES": [
        "final_image",
        "allowed_mask",
        "preview_image"
      ],
      "FUNCTION": "finish",
      "CATEGORY": "VMNodes/Internal",
      "OUTPUT_NODE": true,
      "DEV_ONLY": true
    },
    "VMMOSSLayoutStudio": {
      "inputs": {
        "required": {
          "ui_language": [
            [
              "中文 (ZH)",
              "English (EN)"
            ],
            {
              "default": "中文 (ZH)"
            }
          ],
          "canvas_preset": [
            [
              "Custom (自定义宽高 / Custom W×H)",
              "Poster 3:4 Standard (896x1152)",
              "Poster 3:4 HD (1152x1536)",
              "Poster 2:3 Standard (832x1216)",
              "Poster 2:3 HD (1024x1536)",
              "Mobile 9:16 Standard (768x1344)",
              "Mobile 9:16 HD (1088x1920)",
              "Infographic 1:2 Long (768x1536)",
              "Infographic 1:2 HD (896x1792)",
              "Print A4 Portrait (896x1264)",
              "Print A4 HD (1216x1728)",
              "Square 1:1 Standard (1024x1024)",
              "Square 1:1 HD (1536x1536)",
              "Landscape 4:3 (1152x896)",
              "Campaign 3:2 HD (1536x1024)",
              "Banner 16:9 Standard (1344x768)",
              "Banner 16:9 HD (1920x1088)",
              "Ultrawide 21:9 (1536x640)"
            ],
            {
              "default": "Poster 3:4 Standard (896x1152)"
            }
          ],
          "width": [
            "INT",
            {
              "default": 896,
              "min": 256,
              "max": 4096,
              "step": 16
            }
          ],
          "height": [
            "INT",
            {
              "default": 1152,
              "min": 256,
              "max": 4096,
              "step": 16
            }
          ],
          "bbox_ratio_sync": [
            [
              "Smart (文字/主体保比例，背景铺满)",
              "Keep Box Aspect (所有框保持自身长宽比)",
              "Stretch with Canvas (随画布比例弹性拉伸)",
              "Center Layout (居中扩展，缩小时整体适配)"
            ],
            {
              "default": "Smart (文字/主体保比例，背景铺满)"
            }
          ],
          "scene_meta": [
            [
              "poster",
              "infographic",
              "product campaign",
              "editorial",
              "comic",
              "illustration",
              "photography",
              "ui_design",
              "none (不写入 meta)"
            ],
            {
              "default": "poster"
            }
          ],
          "canvas_layout_type": [
            [
              "single",
              "multi_panel",
              "collage"
            ],
            {
              "default": "single"
            }
          ],
          "layer_order_mode": [
            [
              "Auto (背景->物体->角色->文字置顶)",
              "Manual (严格按列表手动顺序)"
            ],
            {
              "default": "Auto (背景->物体->角色->文字置顶)"
            }
          ],
          "global_prompt": [
            "STRING",
            {
              "multiline": true,
              "default": "",
              "placeholder": "整体画面、背景、光影与排版风格描述 (summary.caption)..."
            }
          ],
          "layout_data": [
            "STRING",
            {
              "default": "{}",
              "multiline": false
            }
          ]
        },
        "optional": {
          "ref_image": [
            "IMAGE"
          ],
          "external_layout_json": [
            "STRING",
            {
              "forceInput": true,
              "tooltip": "Draft JSON (abs/xyxy) or compiled JSON (abs_centralized/yxyx) from the moss-image-prompt-enhancer Skill or an LLM."
            }
          ],
          "external_sync_mode": [
            [
              "Ignore (仅使用画布)",
              "Replace Canvas (用外部 JSON 覆盖画布并回填)",
              "Merge into Canvas (追加到当前画布并回填)"
            ],
            {
              "default": "Replace Canvas (用外部 JSON 覆盖画布并回填)"
            }
          ],
          "custom_meta_tags": [
            "STRING",
            {
              "default": "",
              "multiline": false,
              "tooltip": "Extra medium/genre tags, comma separated; merged into summary.meta."
            }
          ]
        }
      },
      "RETURN_TYPES": [
        "STRING",
        "STRING",
        "IMAGE",
        "INT",
        "INT"
      ],
      "RETURN_NAMES": [
        "layout_prompt",
        "draft_json",
        "preview_image",
        "width",
        "height"
      ],
      "FUNCTION": "compile_layout",
      "CATEGORY": "VMNodes/MOSS",
      "OUTPUT_NODE": true,
      "DEV_ONLY": null
    }
  },
  "display_names": {
    "VMImageEdit": "VM Image Edit",
    "VMImageResizeAlign": "VM Image Resize & Align",
    "VMFinalizeEdit": "VM Internal Composite",
    "VMImageEditBridge": "VM Image Edit",
    "VMEditPlan": "VM Internal Range Plan",
    "VMEditFinish": "VM Internal Preview & Composite",
    "VMMOSSLayoutStudio": "VM MOSS Layout Studio"
  },
  "workflow_sha256": "0bb7f64e800424b3a1eea2a004b5be83d0f927700023ef09f3b98eb8ad7f7d0b",
  "workflow_sha256_lf": "df8e5e4fc0b6c5c30bc32420abfe9879810a3309d886282a4cb0051a36812713"
}
